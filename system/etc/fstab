# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a device; this may
# be used with UUID= as a more robust way to name devices that works even if
# disks are added and removed. See fstab(5).
#
# <file system>             <mount point>  <type>  <options>  <dump>  <pass>
UUID=4DFC-F44A                            /boot          vfat    defaults,umask=0077 0 2
/dev/mapper/luks-6f883926-63cf-42ec-90a3-8e194840b2d0 /              btrfs   subvol=/@,defaults,noatime,compress=zstd:1 0 0
/dev/mapper/luks-6f883926-63cf-42ec-90a3-8e194840b2d0 /home          btrfs   subvol=/@home,defaults,noatime,compress=zstd:1 0 0
/dev/mapper/luks-6f883926-63cf-42ec-90a3-8e194840b2d0 /root          btrfs   subvol=/@root,defaults,noatime,compress=zstd:1 0 0
/dev/mapper/luks-6f883926-63cf-42ec-90a3-8e194840b2d0 /srv           btrfs   subvol=/@srv,defaults,noatime,compress=zstd:1 0 0
/dev/mapper/luks-6f883926-63cf-42ec-90a3-8e194840b2d0 /var/cache     btrfs   subvol=/@cache,defaults,noatime,compress=zstd:1 0 0
/dev/mapper/luks-6f883926-63cf-42ec-90a3-8e194840b2d0 /var/tmp       btrfs   subvol=/@tmp,defaults,noatime,compress=zstd:1 0 0
/dev/mapper/luks-6f883926-63cf-42ec-90a3-8e194840b2d0 /var/log       btrfs   subvol=/@log,defaults,noatime,compress=zstd:1 0 0
tmpfs                                     /tmp           tmpfs   defaults,noatime,mode=1777 0 0
/swap/swapfile none swap defaults 0 0
