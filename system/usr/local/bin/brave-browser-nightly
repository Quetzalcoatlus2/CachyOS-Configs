#!/usr/bin/env bash
PROFILE_DIR="${HOME}/.config/BraveSoftware/Brave-Browser-Nightly"
PREF="$PROFILE_DIR/Default/Preferences"
STATE="$PROFILE_DIR/Local State"

if [ -f "$PREF" ] && ! pgrep -f "brave-nightly/brave" > /dev/null; then
  jq '.browser.custom_chrome = false
    | .brave.web_view_rounded_corners = false
    | .brave.ai_chat.enabled = false
    | .brave.today.opted_in = false
    | .brave.rewards.enabled = false' "$PREF" > "${PREF}.tmp" && mv "${PREF}.tmp" "$PREF"
fi
if [ -f "$STATE" ] && ! pgrep -f "brave-nightly/brave" > /dev/null; then
  jq '.performance_tuning.high_efficiency_mode.state = 2
    | .performance_tuning.high_efficiency_mode.aggressiveness = 2
    | .performance_tuning.high_efficiency_mode.time_before_discard_in_minutes = 5' "$STATE" > "${STATE}.tmp" && mv "${STATE}.tmp" "$STATE"
fi

# stderr is intentionally NOT redirected: VA-API and GPU-driver failures are
# only visible in the journal, so suppressing it hides exactly the problems
# the flags below are meant to surface.
exec /opt/brave.com/brave-nightly/brave-browser \
  --ozone-platform=wayland \
  --disable-features=WaylandOverlayDelegation,WaylandFractionalScaleV1,WaylandWindowDecorations,BraveWebViewRoundedCorners,HistoryEmbeddings,BraveAIChat,BraveRewards,BraveWallet \
  --enable-features=HighEfficiencyModeAvailable,BatterySaverModeAvailable,VaapiVideoDecoder,VaapiIgnoreDriverChecks,AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL \
  --process-per-site \
  --renderer-process-limit=6 \
  --disable-gpu-vsync \
  --user-data-dir="$PROFILE_DIR" \
  "$@"
