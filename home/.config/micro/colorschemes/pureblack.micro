color-link default "#ffffff,#000000"
color-link color-column "#000000"
color-link cursor-line "#000000"
color-link line-number "#555555,#000000"
color-link current-line-number "#ffffff,#000000"
color-link statusline "#000000,#ffffff"
color-link tabbar "#ffffff,#000000"
color-link comment "brightblack"
color-link constant "magenta"
color-link identifier "brightwhite"
color-link statement "cyan"
color-link symbol "yellow"
color-link type "blue"
color-link string "green"
