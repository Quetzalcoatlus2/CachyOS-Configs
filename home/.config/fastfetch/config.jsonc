{
  // Fastfetch config for CachyOS (Sway).
  //
  // Full sweep: every module that reports something on this machine, grouped
  // into sections. The default preset renders 25 lines; this renders ~65.
  //
  // Modules that return nothing here are deliberately omitted rather than
  // left to render blank: wmtheme, icons, font, terminalfont, terminaltheme,
  // terminalsize, physicalmemory, bluetooth, wallpaper, gamepad, zpool, plus
  // command/custom/logo which need per-user content.
  //
  // Timing measured on this machine (mean per invocation):
  //   this config .................. ~410 ms
  //   without `top` ............... ~150 ms
  //   stock default preset ......... ~25 ms
  //
  // `cpuusage`, `top`, `netio` and `diskiо` all need sampling and share one
  // window, so they do not stack. `opengl`/`vulkan`/`opencl` each dlopen a
  // driver and are the next largest cost after `top`.
  //
  // Note: `structure` is a CLI-only option and is ignored in this file; the
  // module list below is what drives the output.
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto"
  },

  "modules": [
    // ---- Identity -------------------------------------------------------
    { "type": "title" },
    { "type": "separator" },
    { "type": "os" },
    { "type": "host" },
    { "type": "bios" },
    { "type": "board" },
    { "type": "chassis" },
    { "type": "bootmgr" },
    { "type": "kernel" },
    { "type": "initsystem" },
    { "type": "locale" },
    { "type": "datetime" },
    { "type": "users" },

    { "type": "break" },

    // ---- Session --------------------------------------------------------
    { "type": "uptime" },
    { "type": "loadavg" },
    { "type": "processes" },
    { "type": "packages" },
    { "type": "shell" },
    { "type": "editor" },
    { "type": "terminal" },
    { "type": "display" },
    { "type": "monitor" },
    { "type": "brightness" },
    { "type": "lm" },
    { "type": "de" },
    { "type": "wm" },
    { "type": "theme" },
    { "type": "cursor" },

    { "type": "break" },

    // ---- Compute --------------------------------------------------------
    { "type": "cpu" },
    { "type": "cpucache" },
    { "type": "cpuusage" },
    { "type": "gpu" },
    { "type": "memory" },
    { "type": "swap" },

    { "type": "break" },

    // ---- Storage --------------------------------------------------------
    { "type": "disk" },
    { "type": "physicaldisk" },
    { "type": "diskiо" },
    { "type": "btrfs" },
    { "type": "tpm" },

    { "type": "break" },

    // ---- Graphics API ---------------------------------------------------
    { "type": "opengl" },
    { "type": "vulkan" },
    { "type": "opencl" },

    { "type": "break" },

    // ---- Power and network ---------------------------------------------
    { "type": "battery" },
    { "type": "poweradapter" },
    { "type": "wifi" },
    { "type": "localip" },
    { "type": "publicip" },
    { "type": "dns" },
    { "type": "netio" },
    { "type": "sound" },
    { "type": "codec" },

    { "type": "break" },

    // ---- Peripherals and media -----------------------------------------
    { "type": "keyboard" },
    { "type": "mouse" },
    { "type": "camera" },
    { "type": "media" },
    { "type": "player" },

    { "type": "break" },

    // ---- Heaviest processes --------------------------------------------
    { "type": "top", "processes": 5, "cpu": true, "memory": true, "io": true },

    { "type": "break" },

    { "type": "version" },
    { "type": "colors" }
  ]
}