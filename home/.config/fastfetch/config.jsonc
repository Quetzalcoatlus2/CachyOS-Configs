{
  // Fastfetch config for CachyOS (Sway).
  //
  // Reproduces the full hardware/session module set, then extends it with
  // live telemetry the default preset omits: top processes, disk and network
  // throughput, and the Wi-Fi link.
  //
  // Output runs ~40 lines, so on a 24-row terminal you will scroll to reach
  // the prompt. That is a deliberate trade for the density of information.
  //
  // Timing measured on this machine (mean per invocation):
  //   this config .................. ~290 ms
  //   same, minus `top` ........... ~26 ms
  //   stock default preset ......... ~23 ms
  //
  // `cpuusage` and `top` both need a sampling window and share one, so the
  // two together cost no more than `top` alone. Dropping `top` is the only
  // meaningful way to cut startup time here.
  //
  // Note: `structure` is a CLI-only option and is ignored in this file; the
  // module list below is what drives the output.
  "$schema": "https://raw.githubusercontent.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto"
  },

  "modules": [
    // Identity
    { "type": "title" },
    { "type": "separator" },
    { "type": "os" },
    { "type": "host" },
    { "type": "bios" },
    { "type": "board" },
    { "type": "chassis" },
    { "type": "bootmgr" },
    { "type": "kernel" },
    { "type": "initsystem" },

    { "type": "break" },

    // Session
    { "type": "uptime" },
    { "type": "loadavg" },
    { "type": "processes" },
    { "type": "packages" },
    { "type": "shell" },
    { "type": "editor" },
    { "type": "terminal" },
    { "type": "display" },
    { "type": "monitor" },
    { "type": "brightness" },
    { "type": "lm" },
    { "type": "de" },
    { "type": "wm" },
    { "type": "theme" },
    { "type": "cursor" },

    { "type": "break" },

    // Hardware
    { "type": "cpu" },
    { "type": "cpucache" },
    { "type": "cpuusage" },
    { "type": "gpu" },
    { "type": "memory" },
    { "type": "swap" },
    { "type": "disk" },

    { "type": "break" },

    // Power and connectivity
    { "type": "battery" },
    { "type": "poweradapter" },
    { "type": "wifi" },
    { "type": "localip" },
    { "type": "netio" },

    { "type": "break" },

    // Top processes by CPU, memory and disk I/O.
    { "type": "top", "processes": 5, "cpu": true, "memory": true, "io": true },

    { "type": "break" },

    { "type": "version" },
    { "type": "colors" }
  ]
}