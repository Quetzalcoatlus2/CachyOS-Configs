{
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/scratchpad",
    "sway/window"
  ],
  "modules-center": [
    "mpris"
  ],
  "modules-right": [
    "custom/updates",
    "temperature",
    "cpu",
    "memory",
    "disk",
    "custom/network",
    "pulseaudio",
    "pulseaudio#microphone",
    "backlight",
    "battery",
    "custom/calendar",
    "idle_inhibitor",
    "custom/notifications",
    "custom/power",
    "tray"
  ],
  "sway/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{name} {windows}",
    "format-window-separator": " ",
    "window-rewrite-default": "🪟",
    "window-rewrite": {
        "class<foot>": "",
        "class<(Gnome-terminal|com.gexperts.Tilix)>": "",
        "title<OpenCode>": "🤖",
        "class<brave-browser.*>": "🦁",
        "class<com.microsoft.VSCode>": "💻",
        "class<code-insiders>": "💻",
        "class<com.microsoft.VSCodeInsiders>": "💻",
        "class<thunar>": "📁",
        "class<org.gnome.Nautilus>": "📁",
        "class<pavucontrol>": "🎛️",
        "class<spotify>": "🎵",
        "class<microsoft-edge>": "🌐",
        "class<teams-for-linux.*>": "💬",
        "class<MATLABWindow>": "🧮",
        "class<firefox.*>": "🦊",
        "class<google-chrome.*>": "🌍",
        "class<chromium.*>": "🌍",
        "class<libreoffice-writer>": "📝",
        "class<libreoffice-calc>": "📊",
        "class<libreoffice-impress>": "📽️",
        "class<libreoffice-draw>": "✏️",
        "class<libreoffice-math>": "📐",
        "class<libreoffice-base>": "🗄️",
        "class<libreoffice-startcenter>": "📑",
        "class<(org.gnome.Evince|evince)>": "📕",
        "class<(org.gnome.eog|eog)>": "🖼️",
        "class<vlc>": "🎬",
        "class<simplescreenrecorder>": "💥",
        "class<[Gg]imp.*>": "🖌️",
        "class<[Pp]inta>": "🎨",
        "class<(org.gnome.Evolution|evolution)>": "📧",
        "class<(org.gnome.gedit|gedit)>": "📄",
        "class<(bcompare|Beyond.*)>": "⚖️",
        "class<org.gnome.Calculator>": "🔢",
        "class<org.gnome.DiskUtility>": "💽",
        "class<org.gnome.FileRoller>": "🗜️",
        "title<.*Simulink.*>": "📈"
      },
    "tooltip": true,
    "tooltip-format": "Workspace Navigation:\n•Active Workspace: {name}\n•Scroll / Click: Switch between virtual workspaces"
  },
  "sway/mode": {
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Sway Keybinding Mode: {}\nIndicates active modal key bindings."
  },
  "sway/scratchpad": {
    "format": "🗃{count}",
    "show-empty": false,
    "tooltip": false,
    "on-click": "swaymsg scratchpad show"
  },
  "sway/window": {
    "format": "{}",
    "max-length": 35,
    "tooltip": true,
    "tooltip-format": "Focused Application Window:\n•Window Title: {title}\n•Application ID: {app_id}"
  },
  "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "format-paused": "{status_icon} {title} - {artist}",
    "max-length": 30,
    "player-icons": {
      "default": "▶",
      "spotify": "🎵"
    },
    "status-icons": {
      "paused": ""
    },
    "tooltip-format": "{player}: {title} - {artist}",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "custom/updates": {
    "format": "📦{}",
    "interval": 3600,
    "exec": "$HOME/.config/waybar/scripts/check-updates.sh",
    "return-type": "json",
    "on-click": "foot -e zsh -ic 'update; rc=$?; printf \"\\nUpdate complete. Press any key to close...\"; read -r -s -k 1; exit \"$rc\"'",
    "signal": 8,
    "tooltip": true
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
    "input-filename": "temp1_input",
    "interval": 2,
    "critical-threshold": 85,
    "format": "🌡️{temperatureC}°C",
    "format-critical": "🔥{temperatureC}°C",
    "tooltip": true,
    "tooltip-format": "Thermal Monitoring:\n•Current Temperature: {temperatureC}°C ({temperatureF}°F)\n•Critical Threshold: 85°C"
  },
  "cpu": {
    "interval": 2,
    "format": "⚡{usage}%",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "tooltip": true,
    "tooltip-format": "Processor Telemetry:\n•Total CPU Load: {usage}%\n•Mean Frequency: {avg_frequency} GHz\n•System Load: {load}\n•Core Breakdown:\n{core_frequencies}\n\nAction: Click to launch btop.",
    "on-click": "foot -e btop"
  },
  "memory": {
    "interval": 2,
    "format": "🧠{percentage}%",
    "states": {
      "warning": 75,
      "critical": 90
    },
    "tooltip": true,
    "tooltip-format": "Memory & Swap Allocation:\n•Physical RAM Used: {used:0.2f} GiB / {total:0.2f} GiB ({percentage}%)\n•Available Memory: {avail:0.2f} GiB\n•Swap Allocation: {swapUsed:0.2f} GiB / {swapTotal:0.2f} GiB ({swapPercentage}%)\n\nAction: Click to launch btop.",
    "on-click": "foot -e btop"
  },
  "disk": {
    "interval": 30,
    "format": "💾{percentage_used}%",
    "path": "/",
    "states": {
      "warning": 80,
      "critical": 90
    },
    "tooltip": true,
    "tooltip-format": "Root Storage Subvolume:\n•Mount Point: {path}\n•Space Consumed: {used} / {total} ({percentage_used}%)\n•Available Storage: {free} ({percentage_free}% remaining)"
  },
  "custom/network": {
    "align": 0,
    "min-length": 43,
    "max-length": 43,
    "interval": 1,
    "exec": "$HOME/.config/waybar/scripts/network-traffic.py",
    "return-type": "json",
    "tooltip": true,
    "on-click": "foot nmtui"
  },
  "pulseaudio": {
    "max-volume": 100,
    "format": "{icon} {volume}%",
    "format-muted": "🔇 Muted",
    "format-icons": {
      "headphone": [
        "🎧🔈",
        "🎧🔉",
        "🎧🔊",
        "🎧📢"
      ],
      "hands-free": [
        "🎧🔈",
        "🎧🔉",
        "🎧🔊",
        "🎧📢"
      ],
      "headset": [
        "🎧🔈",
        "🎧🔉",
        "🎧🔊",
        "🎧📢"
      ],
      "phone": [
        "📞🔈",
        "📞🔉",
        "📞🔊",
        "📞📢"
      ],
      "portable": [
        "📱🔈",
        "📱🔉",
        "📱🔊",
        "📱📢"
      ],
      "car": [
        "🚗🔈",
        "🚗🔉",
        "🚗🔊",
        "🚗📢"
      ],
      "default": [
        "🔈",
        "🔉",
        "🔊",
        "📢"
      ]
    },
    "tooltip": true,
    "tooltip-format": "Audio Output (PipeWire Sinks):\n•Target Device: {desc}\n•Master Volume: {volume}%\n\nControls:\n•Left-Click: Open pavucontrol mixer\n•Right-Click: Toggle master mute\n•Scroll Up/Down: Adjust volume by 5%",
    "on-click": "GTK_THEME=Adwaita:dark pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "reverse-scrolling": true,
    "reverse-mouse-scrolling": true
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "🎙️{volume}%",
    "format-source-muted": "🎙️Muted",
    "scroll-step": 2,
    "tooltip": true,
    "tooltip-format": "Microphone Input (PipeWire Sources):\n•Input Device: {desc}\n•Gain Level: {volume}%\n\nControls:\n•Left-Click: Open input devices in pavucontrol\n•Right-Click: Toggle microphone mute\n•Scroll Up/Down: Adjust capture gain by 2%",
    "on-click": "GTK_THEME=Adwaita:dark pavucontrol -t 4",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "reverse-scrolling": true,
    "reverse-mouse-scrolling": true
  },
  "backlight": {
    "format": "🔆{percent}%",
    "tooltip": true,
    "tooltip-format": "Display Luminance:\n•Brightness Level: {percent}%\n\nControls:\n•Scroll Up: Decrease brightness by 2%\n•Scroll Down: Increase brightness by 2%",
    "on-scroll-up": "brightnessctl set 2%+",
    "on-scroll-down": "brightnessctl set 2%-",
    "reverse-scrolling": true,
    "reverse-mouse-scrolling": true
  },
  "battery": {
    "interval": 10,
    "full-at": 90,
    "states": {
      "warning": 25,
      "critical": 20,
      "danger": 15
    },
    "format": "🔋{icon}{capacity}% ({time})",
    "format-discharging": "🔋{icon}{capacity}% ({time})",
    "format-charging": "⚡{capacity}% ({time})",
    "format-plugged": "🔌{capacity}%",
    "format-full": "🔋{capacity}% (FULL)",
    "format-alt": "🔋{icon} {time}",
    "format-time": "{H}h:{M}min",
    "tooltip": true,
    "tooltip-format": "Power Subsystem Metrics:\n•Charge Level: {capacity}%\n•Estimated Runtime: {time}\n•Current Consumption: {power:.2f} W\n•Battery Health: {health}%\n•Total Charge Cycles: {cycles}"
  },
  "custom/calendar": {
    "format": "{}",
    "align": 1,
    "min-length": 21,
    "max-length": 21,
    "interval": 1,
    "exec": "python3 $HOME/.config/waybar/scripts/calendar-belgium.py",
    "return-type": "json",
    "tooltip": true
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "☕ON",
      "deactivated": "☕OFF"
    },
    "tooltip": true,
    "tooltip-format-activated": "Idle Inhibitor: Active\nPrevents display dimming and screen timeouts.\nClick: Restore normal timers.",
    "tooltip-format-deactivated": "Idle Inhibitor: Inactive\nStandard screen timeouts are active.\nClick: Keep display permanently awake."
  },
  "custom/power": {
    "format": "💡",
    "tooltip": true,
    "tooltip-format": "Power Management Options\n\nClick: Toggle power and session actions.",
    "on-click": "$HOME/.config/waybar/scripts/power-menu.sh"
  },
  "tray": {
    "icon-size": 14,
    "spacing": 0
  },
  "custom/notifications": {
    "format": "🔔 {text}",
    "exec": "(makoctl list -j 2>/dev/null || makoctl list 2>/dev/null) | jq -Rsc 'try (fromjson | if type==\"array\" then length elif type==\"object\" then (.data[0] | length) else 0 end) catch ([splits(\"\\n\") | select(startswith(\"Notification \"))] | length) | . as $n | {text: ($n | tostring), class: (if $n == 0 then \"notif-0\" elif $n >= 8 then \"notif-8\" else \"notif-\\($n)\" end)}'",
    "return-type": "json",
    "interval": 2,
    "tooltip-format": "Active notifications: {text}",
    "on-click": "makoctl restore",
    "on-click-right": "makoctl dismiss -a",
    "on-click-middle": "makoctl menu -- wofi --dmenu -p 'Notification:'"
  }
}
