font=monospace 11
background-color=#000000
text-color=#ffffff
border-color=#777777
border-size=2
border-radius=4
width=380
height=220
margin=40,12,12
padding=12
anchor=top-right
layer=overlay
markup=0
max-visible=5
max-history=100
history=1
default-timeout=15000
ignore-timeout=1
on-button-left=invoke-default-action
on-button-right=dismiss

