#!/bin/sh

prefix="$HOME/.local/opt/swayfx"
wlroots_prefix="$HOME/.local/opt/sway-1.12"
state="$HOME/.local/state/sway-displaylink-debug"
intel_device=$(readlink -f /dev/dri/by-path/pci-0000:00:02.0-card) || exit 1
export WLR_DRM_DEVICES="$intel_device"
for connector in /sys/class/drm/card*-DVI*; do
	[ -r "$connector/status" ] || continue
	[ "$(cat "$connector/status")" = connected ] || continue
	connector_name=${connector##*/}
	export WLR_DRM_DEVICES="$intel_device:/dev/dri/${connector_name%%-*}"
	break
done
export PATH="$prefix/bin:$wlroots_prefix/bin:$HOME/.local/bin:$PATH"
# Sway's libraries go to the dynamic loader, not into LD_LIBRARY_PATH, so the
# applications sway starts do not inherit the override.
sway_libs="$prefix/lib/x86_64-linux-gnu:$wlroots_prefix/lib"
loader=/lib64/ld-linux-x86-64.so.2
export XLOCALEDIR=/usr/share/X11/locale
export WLR_RENDER_DRM_DEVICE=/dev/dri/by-path/pci-0000:00:02.0-render
export WLR_RENDERER=gles2
unset WLR_RENDERER_ALLOW_SOFTWARE

mkdir -p "$state" || exit 1
if [ -x /usr/bin/gdb ] && [ -r "$HOME/.config/sway/crash-capture.gdb" ]; then
	mkdir -p -m 0700 "$state/crash-captures" || exit 1
	capture=$(mktemp "$state/crash-captures/session-$(date +%Y%m%d-%H%M%S)-XXXXXX.log") || exit 1
	printf '\nSway session %s: debugger capture %s\n' "$(date --iso-8601=seconds)" "$capture" >>"$state/session.log"
	exec env -u LD_LIBRARY_PATH /usr/bin/gdb -q -nx -nh -batch \
		-iex 'set debuginfod enabled off' \
		-ex "set logging file $capture" \
		-ex 'set logging overwrite on' \
		-ex 'set logging redirect on' \
		-ex 'set logging enabled on' \
		-x "$HOME/.config/sway/crash-capture.gdb" \
		--args "$loader" --library-path "$sway_libs" "$prefix/bin/sway" --unsupported-gpu "$@" \
		</dev/null >>"$state/session.log" 2>&1
fi
printf '\nSway session %s: debugger capture unavailable\n' "$(date --iso-8601=seconds)" >>"$state/session.log"
exec "$loader" --library-path "$sway_libs" "$prefix/bin/sway" --unsupported-gpu "$@" 2>>"$state/session.log"
